# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/murmullo

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=http://localhost:5174,http://localhost:3000

# API Keys (server-side, not exposed to clients)
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GROQ_API_KEY=gsk_your-groq-key

# Transcription Provider (openai or groq, default: openai)
# Groq is faster (~5-10x) and cheaper (~9x) but less accurate for Spanish accents
# Recommend: groq for speed, openai for quality
TRANSCRIPTION_PROVIDER=groq

# Logging
LOG_LEVEL=info
